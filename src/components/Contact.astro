---
---
<section class="contact" id="contact">
  <div class="container contact-inner" data-animate>
    <div class="mono lbl">04 — Work With Me</div>
    <h2 class="contact-h2">Have something worth <em>building</em>?</h2>
    <p class="contact-lead">I work with a small number of clients at a time. Tell me about your project — if it's a good fit, I'll reach back out to set up a call.</p>

    <form class="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
      <div class="row">
        <label>Name<input type="text" name="name" required /></label>
        <label>Email<input type="email" name="email" required /></label>
      </div>
      <div class="row">
        <label>Project type
          <select name="project-type">
            <option>Web Development</option>
            <option>Web App</option>
            <option>AI Tool</option>
            <option>Other</option>
          </select>
        </label>
        <label>Budget range
          <select name="budget">
            <option>Under $5k</option>
            <option>$5k–$15k</option>
            <option>$15k–$30k</option>
            <option>$30k+</option>
          </select>
        </label>
      </div>
      <label>Tell me about your project<textarea name="message" rows="4" required></textarea></label>
      <button type="submit" class="btn btn-primary">Get In Touch</button>
    </form>
  </div>
</section>

<style>
  .contact { background: var(--paper-2); padding: var(--section-py) 0; position: relative; z-index: 2; }
  .contact-inner { max-width: 720px; text-align: center; }
  .contact .lbl { color: var(--accent-ink); margin-bottom: 1.25rem; }
  .contact-h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.02; letter-spacing: -0.02em; margin-bottom: 1.375rem; }
  .contact-h2 em { font-style: normal; color: var(--primary); }
  .contact-lead { color: var(--ink-soft); max-width: 44ch; margin: 0 auto 2.5rem; font-size: 1.06rem; }
  .contact-form { text-align: left; display: flex; flex-direction: column; gap: 1.125rem; }
  .contact-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.125rem; }
  .contact-form label { display: flex; flex-direction: column; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .contact-form input, .contact-form select, .contact-form textarea {
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem; font-family: var(--font-sans); font-size: 0.95rem; color: var(--ink);
    transition: border-color 0.2s;
  }
  .contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus { border-color: var(--primary); outline: none; }
  .contact-form textarea { resize: vertical; }
  .contact-form button { align-self: flex-start; margin-top: 0.5rem; }
  .hidden { display: none; }
  @media (max-width: 640px) { .contact-form .row { grid-template-columns: 1fr; } }
</style>
