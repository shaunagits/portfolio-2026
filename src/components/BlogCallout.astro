<aside class="blog-callout">
  <slot />
</aside>

<style>
  .blog-callout {
    border-left: 3px solid var(--c-accent);
    background: var(--primary-50);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--c-text);
  }

  .blog-callout :global(strong),
  .blog-callout :global(b) {
    color: var(--accent-ink);
  }

  .blog-callout :global(p) {
    margin-bottom: 0;
    color: var(--c-text);
  }
</style>
