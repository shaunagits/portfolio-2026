---
import LogoS from './LogoS.astro';

// Writing goes LAST so the three homepage anchors stay contiguous — it's the only
// item here that navigates to another page rather than scrolling this one.
const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Services', href: '/#services' },
  { label: 'Writing', href: '/blog' },
];
---

<header class="nav" id="home">
  <div class="nav-inner container">
    {/* The mark carries no name, so the aria-label is now the only place the link
        says where it goes — keep it. The name is reintroduced in the hero. */}
    <a href="/" class="nav-logo" aria-label="Shauna home"><LogoS class="nav-mark" animate /></a>

    <nav class="nav-desktop" aria-label="Main navigation">
      <ul class="nav-links">
        {links.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
        <li><a href="/#contact" class="nav-cta">Work With Me</a></li>
      </ul>
    </nav>

    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-overlay">Menu</button>
  </div>
</header>

<div class="nav-overlay" id="nav-overlay" aria-hidden="true">
  <nav aria-label="Mobile navigation">
    <ul class="nav-overlay-links">
      {links.map((link) => (
        <li><a href={link.href} class="nav-overlay-link">{link.label}</a></li>
      ))}
      <li><a href="/#contact" class="nav-overlay-link nav-overlay-cta">Work With Me</a></li>
    </ul>
  </nav>
</div>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s var(--ease);
  }
  .nav-logo, .nav-link, .nav-toggle { transition: color 0.3s var(--ease); }
  .nav.is-scrolled { border-bottom-color: var(--line); }

  /* Over a dark band (About / Footer / next-project) the translucent white nav
     reads as grey. Swap the whole bar to teal with white content instead.
     Uses --accent-ink (#1F6A75), not --primary (#2C8C99): white on #2C8C99 is
     3.95:1 — below AA for the 14px nav links. On #1F6A75 it's 6.22:1, so every
     link and the CTA hover on the bar pass at once. The bar just reads deeper. */
  .nav.is-over-dark {
    background: var(--accent-ink);
    border-bottom-color: transparent;
  }
  .nav.is-over-dark .nav-logo,
  .nav.is-over-dark .nav-logo:hover,
  .nav.is-over-dark .nav-link,
  .nav.is-over-dark .nav-toggle { color: var(--on-accent); }
  .nav.is-over-dark .nav-link::after { background: var(--on-accent); }
  .nav.is-over-dark .nav-link:hover { color: rgba(var(--paper-rgb),0.75); }
  .nav.is-over-dark .nav-toggle { border-color: rgba(var(--paper-rgb),0.45); }
  /* teal-on-teal would vanish — invert the CTA to a white pill on the bar.
     The offset shape is a WHITE OUTLINE, made by stacking a knockout (1.5px smaller,
     painted on top) over a solid --paper shape. The knockout must be the BAR's own
     colour to read as a clean ring — the bar is --accent-ink, so the knockout is too
     (a --primary knockout would leave a faint teal seam now the bar is deeper). */
  .nav.is-over-dark .nav-cta {
    background: var(--paper); border-color: var(--paper);
    /* --accent-ink, not --primary: this label is 14px, and #2C8C99 on white is
       3.95:1 — below AA. #1F6A75 is 6.22:1. Same rule the rest of the system
       follows for small teal text on white. */
    color: var(--accent-ink);
    box-shadow: var(--btn-offset) calc(var(--btn-offset) * -1) 0 -1.5px var(--accent-ink),
                var(--btn-offset) calc(var(--btn-offset) * -1) 0 0 var(--paper);
  }
  /* The ring slides home and becomes the button's own outline: the fill drops out
     to let the bar through, leaving a white-outlined pill with white text. */
  .nav.is-over-dark .nav-cta:hover, .nav.is-over-dark .nav-cta:focus-visible {
    background: transparent; border-color: var(--paper); color: var(--paper);
    box-shadow: 0 0 0 -1.5px var(--accent-ink), 0 0 0 0 var(--paper);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  /* Teal at rest; .nav.is-over-dark below flips this to --on-accent and the mark
     follows via currentColor — teal-on-teal would otherwise vanish on the footer bar. */
  /* The load entrance lives in LogoS.astro (`animate` prop): the mark's own
     speed-streaks fly in from the left, staggered. Nothing to animate here —
     the streaks are part of the mark, and they inherit currentColor, so the
     entrance works in both the teal-on-white and white-on-teal states. */
  .nav-logo { display: flex; align-items: center; color: var(--primary); }
  /* :global is required — the <svg> is rendered by LogoS.astro, so it never gets
     this component's scope attribute and a plain .nav-mark selector can't match it
     (it silently computes to height:0 and the logo disappears).
     viewBox is trimmed to the ink, so this is true mark height. */
  .nav-logo :global(.nav-mark) { height: 38px; width: auto; display: block; transition: fill 0.25s var(--ease); }
  .nav-logo:hover { color: var(--accent-ink); }
  .nav-links { display: flex; align-items: center; gap: 2.375rem; }
  .nav-link { position: relative; font-size: 0.875rem; font-weight: 500; color: var(--ink); transition: color 0.2s; }
  .nav-link::after { content: ''; position: absolute; left: 0; bottom: -4px; height: 1px; width: 0; background: var(--primary); transition: width 0.25s var(--ease); }
  .nav-link:hover { color: var(--accent-ink); }
  .nav-link:hover::after { width: 100%; }
  /* Same treatment as .btn-primary: outlined at rest with a solid accent shape of the
     same silhouette offset up-right; on hover the shape slides home and the button takes
     the fill. Smaller offset than the page buttons — this one is persistent and compact.
     (The .btn secondary ring can't be used here: its --paper knockout would show against
     the nav's translucent background and against the teal footer bar.) */
  .nav-cta {
    --btn-offset: 5px;
    padding: 0.65rem 1.25rem; border: 1px solid var(--ink); border-radius: var(--radius-pill);
    background: var(--paper); color: var(--ink); font-size: 0.875rem; font-weight: 500;
    box-shadow: var(--btn-offset) calc(var(--btn-offset) * -1) 0 0 var(--primary);
    transition: background 0.28s var(--ease), color 0.28s var(--ease),
                border-color 0.28s var(--ease), box-shadow 0.34s var(--ease),
                transform 0.12s var(--ease);
  }
  .nav-cta:hover, .nav-cta:focus-visible {
    background: var(--primary); border-color: var(--primary); color: var(--on-accent);
    box-shadow: 0 0 0 0 var(--primary); transform: none;
  }
  .nav-cta:active { transform: scale(0.97); }
  .nav-toggle {
    display: none; align-items: center; gap: 8px; border: 1px solid var(--line);
    border-radius: var(--radius-pill); padding: 0.55rem 1rem;
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink);
  }
  .nav-toggle.is-open { border-color: var(--primary); color: var(--accent-ink); }
  .nav-overlay {
    position: fixed; inset: 0; z-index: 99; background: var(--paper);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .nav-overlay.is-open { opacity: 1; pointer-events: auto; }
  .nav-overlay-links { display: flex; flex-direction: column; align-items: center; gap: 1.75rem; }
  .nav-overlay-link { font-family: var(--font-display); font-size: clamp(2rem, 7vw, 3rem); font-weight: 500; color: var(--ink); transition: color 0.2s; }
  .nav-overlay-link:hover { color: var(--accent-ink); }
  .nav-overlay-cta { color: var(--accent-ink); }
  @media (max-width: 860px) { .nav-desktop { display: none; } .nav-toggle { display: inline-flex; } }
</style>
