---
const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Services', href: '/#services' },
];
---

<header class="nav" id="home">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="Shauna — home">Shauna<span>.</span></a>

    <nav class="nav-desktop" aria-label="Main navigation">
      <ul class="nav-links">
        {links.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
        <li><a href="/#contact" class="nav-cta">Work With Me</a></li>
      </ul>
    </nav>

    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-overlay">Menu</button>
  </div>
</header>

<div class="nav-overlay" id="nav-overlay" aria-hidden="true">
  <nav aria-label="Mobile navigation">
    <ul class="nav-overlay-links">
      {links.map((link) => (
        <li><a href={link.href} class="nav-overlay-link">{link.label}</a></li>
      ))}
      <li><a href="/#contact" class="nav-overlay-link nav-overlay-cta">Work With Me</a></li>
    </ul>
  </nav>
</div>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s var(--ease);
  }
  .nav-logo, .nav-logo span, .nav-link, .nav-toggle { transition: color 0.3s var(--ease); }
  .nav.is-scrolled { border-bottom-color: var(--line); }

  /* Over a dark band (About / Footer / next-project) the translucent white nav
     reads as grey. Swap the whole bar to teal with white content instead. */
  .nav.is-over-dark {
    background: var(--primary);
    border-bottom-color: transparent;
  }
  .nav.is-over-dark .nav-logo,
  .nav.is-over-dark .nav-logo span,
  .nav.is-over-dark .nav-link,
  .nav.is-over-dark .nav-toggle { color: var(--on-accent); }
  .nav.is-over-dark .nav-link::after { background: var(--on-accent); }
  .nav.is-over-dark .nav-link:hover { color: rgba(var(--paper-rgb),0.75); }
  .nav.is-over-dark .nav-toggle { border-color: rgba(var(--paper-rgb),0.45); }
  /* teal-on-teal would vanish — invert the CTA to a white pill */
  .nav.is-over-dark .nav-cta {
    background: var(--paper); border-color: var(--paper); color: var(--primary);
  }
  .nav.is-over-dark .nav-cta:hover {
    background: var(--ink); border-color: var(--ink); color: var(--on-accent);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .nav-logo { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; color: var(--ink); letter-spacing: -0.01em; }
  .nav-logo span { color: var(--accent); }
  .nav-links { display: flex; align-items: center; gap: 2.375rem; }
  .nav-link { position: relative; font-size: 0.875rem; font-weight: 500; color: var(--ink); transition: color 0.2s; }
  .nav-link::after { content: ''; position: absolute; left: 0; bottom: -4px; height: 1px; width: 0; background: var(--primary); transition: width 0.25s var(--ease); }
  .nav-link:hover { color: var(--accent-ink); }
  .nav-link:hover::after { width: 100%; }
  .nav-cta {
    padding: 0.65rem 1.25rem; border: 1px solid var(--primary); border-radius: var(--radius-pill);
    background: var(--primary); color: var(--on-accent); font-size: 0.875rem; font-weight: 500;
    box-shadow: var(--shadow-sm); transition: background 0.25s, transform 0.2s var(--ease);
  }
  .nav-cta:hover { background: var(--ink); border-color: var(--ink); color: var(--paper); transform: translateY(-1px); }
  .nav-toggle {
    display: none; align-items: center; gap: 8px; border: 1px solid var(--line);
    border-radius: var(--radius-pill); padding: 0.55rem 1rem;
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink);
  }
  .nav-toggle.is-open { border-color: var(--primary); color: var(--accent-ink); }
  .nav-overlay {
    position: fixed; inset: 0; z-index: 99; background: var(--paper);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .nav-overlay.is-open { opacity: 1; pointer-events: auto; }
  .nav-overlay-links { display: flex; flex-direction: column; align-items: center; gap: 1.75rem; }
  .nav-overlay-link { font-family: var(--font-display); font-size: clamp(2rem, 7vw, 3rem); font-weight: 500; color: var(--ink); transition: color 0.2s; }
  .nav-overlay-link:hover { color: var(--accent-ink); }
  .nav-overlay-cta { color: var(--accent-ink); }
  @media (max-width: 860px) { .nav-desktop { display: none; } .nav-toggle { display: inline-flex; } }
</style>
