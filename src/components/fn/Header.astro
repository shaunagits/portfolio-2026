---
/**
 * Field-notes header (2026-09-29 redesign).
 * Left: the S mark + the domain as the wordmark.
 * Right: theme toggle, a boxed "Start with [Free assessment]" slot (Shauna's
 * equivalent of the reference site's "Built with [model]" box), and a mono
 * code-style link to the writing.
 */
import LogoS from '../LogoS.astro';
---
<header class="fn-header">
  <div class="fn-header-inner">
    <a href="/" class="fn-brand" aria-label="shauna.digital home">
      <LogoS class="fn-mark" animate />
      <span class="fn-domain">shauna.digital</span>
    </a>

    <div class="fn-right">
      <button class="fn-theme" type="button" aria-label="Switch to dark mode" data-theme-toggle>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
      </button>

      <a href="#start" class="fn-slot">
        <span class="fn-slot-label">Start with</span>
        <span class="fn-slot-box">Free assessment <span aria-hidden="true">&rarr;</span></span>
      </a>

      <a href="/blog" class="fn-code">&lt; writing /&gt;</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    var root = document.documentElement;
    function label() {
      var dark = root.getAttribute('data-theme') === 'dark';
      btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    }
    label();
    btn.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      label();
    });
  })();
</script>

<style>
  .fn-header {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .fn-header-inner {
    height: 60px; padding-inline: clamp(16px, 2.2vw, 28px);
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .fn-brand { display: flex; align-items: center; gap: 10px; color: var(--ink); }
  .fn-brand :global(.fn-mark) { height: 24px; width: auto; color: var(--primary); display: block; }
  .fn-domain { font-weight: 600; font-size: 1rem; letter-spacing: -0.01em; }

  .fn-right { display: flex; align-items: center; gap: clamp(0.75rem, 1.6vw, 1.5rem); }

  .fn-theme {
    width: 36px; height: 36px; display: grid; place-items: center; border-radius: 8px;
    color: var(--ink); transition: background 0.2s;
  }
  .fn-theme:hover { background: var(--paper-2); }
  .fn-theme svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .fn-theme .i-sun { display: none; }
  :global([data-theme="dark"]) .fn-theme .i-sun { display: block; }
  :global([data-theme="dark"]) .fn-theme .i-moon { display: none; }

  /* The boxed slot: a quiet label, then a bordered box in the accent. */
  .fn-slot {
    display: flex; align-items: center; gap: 0; border: 1px solid var(--line);
    border-radius: 4px; padding: 3px 3px 3px 12px; background: var(--paper-2);
    font-size: 0.94rem; color: var(--ink-soft);
  }
  .fn-slot-label { padding-right: 10px; }
  .fn-slot-box {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--primary); border-radius: 3px; background: var(--paper);
    color: var(--ink); padding: 5px 12px; font-weight: 500;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .fn-slot:hover .fn-slot-box, .fn-slot:focus-visible .fn-slot-box {
    background: var(--primary-hover); border-color: var(--primary-hover); color: #fff;
  }
  :global([data-theme="dark"]) .fn-slot:hover .fn-slot-box { color: var(--paper); }

  .fn-code { font-family: var(--font-mono); font-size: 0.9rem; color: var(--ink-soft); white-space: nowrap; transition: color 0.2s; }
  .fn-code:hover { color: var(--accent-ink); }

  @media (max-width: 720px) {
    .fn-slot-label, .fn-code { display: none; }
    .fn-slot { padding: 3px; }
    .fn-domain { font-size: 0.94rem; }
  }
  @media (max-width: 400px) {
    .fn-domain { display: none; }
  }
</style>
