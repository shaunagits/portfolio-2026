---
/**
 * Field-notes hero (2026-09-29 redesign).
 * Kicker row, oversized headline with a teal full stop, lead + "previously"
 * line, a belief paragraph, CTAs, and a right rail with the numbered contents
 * and a handwritten margin note. fig. 1 (Lēʻahi) and the NOW strip follow.
 *
 * Copy is Shauna's working draft (copy doc, 2026-09-29) with em dashes swapped
 * out. The "previously" line and margin note are placeholders until she sends
 * final copy.
 */
import Leahi from './Leahi.astro';

// Numbered contents. Anchors match the section ids chunk 2 builds.
const contents = [
  { n: '01', label: 'Where the money goes', href: '#money' },
  { n: '02', label: 'What I can help with', href: '#help' },
  { n: '03', label: 'The goal', href: '#goal' },
  { n: '04', label: 'How it works', href: '#how' },
  { n: '05', label: 'Field work', href: '#work' },
  { n: '06', label: 'Team training', href: '#training' },
  { n: '07', label: 'Start here', href: '#start' },
];
---
<section class="fn-hero" aria-label="Introduction">
  <div class="fn-wrap">
    <div class="kicker" data-animate>
      <span>Field notes, 2026</span>
      <span>O&#699;ahu &middot; 21.26&deg; N, 157.81&deg; W</span>
    </div>

    <h1 class="fn-title" data-animate data-delay="1">
      Make your business more profitable<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span>
    </h1>

    <div class="hero-grid">
      <div class="hero-main">
        <p class="lead" data-animate data-delay="2">
          I find the <mark>expensive gaps</mark> in your workflows, systems, and processes. Then I build smarter ways to reduce costs, save time, and capture more revenue.
        </p>
        <p class="previously" data-animate data-delay="3">
          <span class="tag">Previously</span>
          Production and operations for programs at Nike and Apple that reached millions of people. Now I build the systems behind small and growing teams.
        </p>

        <p class="belief" data-animate data-delay="3">
          The goal isn&rsquo;t automation for the sake of automation. It&rsquo;s reducing the time and money it takes to get the work done.
        </p>

        <div class="ctas" data-animate data-delay="4">
          <a href="#start" class="btn-ink">Get a Free Assessment <span aria-hidden="true">&rarr;</span></a>
          <a href="#help" class="link-arrow">See How I Can Help <span aria-hidden="true">&darr;</span></a>
        </div>
      </div>

      <aside class="hero-rail" data-animate data-delay="3">
        <nav aria-label="Contents">
          <div class="rail-label">Contents</div>
          <ol class="toc">
            {contents.map((c) => (
              <li><a href={c.href}><span class="n">{c.n}</span><span class="t">{c.label}</span></a></li>
            ))}
          </ol>
        </nav>

        <p class="margin-note" aria-label="Margin note">
          <span>don&rsquo;t forget:</span>
          <span>manual work</span>
          <span>adds up.</span>
        </p>
      </aside>
    </div>

    <div class="fig" data-animate>
      <Leahi />
    </div>
  </div>

  <div class="now-strip">
    <div class="fn-wrap now-inner">
      <svg class="rule" viewBox="0 0 1000 8" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5 C120 3 260 6 400 4 S700 3 820 5 S960 4 1000 3" /></svg>
      <div class="now-row">
        <div class="gutter-label">Now</div>
        <ul class="now-items">
          <li>Booking Q4<span class="cursor" aria-hidden="true"></span></li>
          <li>Based in Hawai&#699;i, working with teams across the US</li>
          <li><a href="#start">Free 15-minute assessments <span aria-hidden="true">&rarr;</span></a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fn-hero { position: relative; overflow: hidden; }
  /* dot grid, fading out toward the bottom of the hero */
  .fn-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(var(--dot) 1px, transparent 1.3px);
    background-size: 24px 24px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 85%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 85%);
  }
  .fn-wrap { position: relative; max-width: 1320px; margin: 0 auto; padding-inline: clamp(16px, 4vw, 56px); }

  .kicker {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft);
  }

  .fn-title {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-display); font-weight: 560;
    font-size: clamp(2.75rem, 8.4vw, 7.4rem); line-height: 0.95; letter-spacing: -0.045em;
    color: var(--ink); max-width: 15ch; text-wrap: balance;
  }
  /* The full stop is a teal disc, sized to the type so it scales with it. */
  .fn-title .stop {
    display: inline-block; width: 0.17em; height: 0.17em; margin-left: 0.04em;
    border-radius: 50%; background: var(--primary); vertical-align: baseline;
  }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: clamp(2rem, 6vw, 7rem); margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-left: var(--gutter);
  }

  .lead { font-size: clamp(1.3rem, 2.3vw, 1.8rem); line-height: 1.35; letter-spacing: -0.015em; color: var(--ink); max-width: 30ch; }
  .lead mark {
    background: var(--highlight); color: var(--accent-ink); padding: 0 0.12em; border-radius: 2px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  .previously { margin-top: 1.25rem; max-width: 56ch; color: var(--ink-soft); font-size: 1rem; line-height: 1.6; }
  .previously .tag { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink); margin-right: 0.5rem; }

  .belief { margin-top: clamp(2rem, 4vw, 3rem); font-size: clamp(1.1rem, 1.6vw, 1.3rem); line-height: 1.6; max-width: 40ch; color: var(--ink); }

  .ctas { margin-top: clamp(2rem, 4vw, 3rem); display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }

  /* Primary CTA. Keeps Shauna's offset-shape gesture, squared off for the
     editorial layout: solid teal block with an ink outline offset behind it;
     on hover the outline slides home. */
  .btn-ink {
    --off: 6px;
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.95rem 1.4rem; border-radius: 3px;
    background: var(--primary-hover); color: #fff; font-weight: 500; font-size: 1.02rem;
    box-shadow: var(--off) var(--off) 0 -1px var(--paper), var(--off) var(--off) 0 0 var(--ink);
    transition: box-shadow 0.3s var(--ease), transform 0.12s var(--ease), background 0.2s;
  }
  .btn-ink:hover, .btn-ink:focus-visible { box-shadow: 0 0 0 -1px var(--paper), 0 0 0 0 var(--ink); background: var(--ink); color: var(--paper); }
  .btn-ink:active { transform: scale(0.98); }
  :global([data-theme="dark"]) .btn-ink { color: var(--paper); background: var(--primary); }

  .link-arrow {
    display: inline-flex; gap: 0.4rem; font-size: 1.02rem; color: var(--ink);
    border-bottom: 1px solid var(--primary); padding-bottom: 2px; transition: color 0.2s, gap 0.2s var(--ease);
  }
  .link-arrow:hover { color: var(--accent-ink); gap: 0.65rem; }

  /* Right rail */
  .rail-label { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 1rem; }
  .toc { display: flex; flex-direction: column; gap: 0.2rem; }
  .toc a { display: flex; align-items: baseline; gap: 1.1rem; padding: 0.35rem 0; color: var(--ink); transition: color 0.2s; }
  .toc .n { font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-soft); min-width: 1.6em; }
  .toc .t { font-size: 1.02rem; background-image: linear-gradient(var(--primary), var(--primary)); background-size: 0 1px; background-repeat: no-repeat; background-position: 0 100%; transition: background-size 0.3s var(--ease); }
  .toc a:hover { color: var(--accent-ink); }
  .toc a:hover .t { background-size: 100% 1px; }

  /* Handwritten-feeling margin note, in mono and the accent, a touch off-axis */
  .margin-note {
    margin-top: clamp(2.5rem, 5vw, 4rem); display: flex; flex-direction: column; gap: 0.15rem;
    font-family: var(--font-mono); font-size: 0.98rem; line-height: 1.5; color: var(--accent-ink);
    transform: rotate(-1.6deg); transform-origin: left top;
  }
  .margin-note span { position: relative; padding-left: 0.1rem; }
  .margin-note span + span::before {
    content: ''; position: absolute; left: -0.9rem; top: 0.72em; width: 6px; height: 6px; border-radius: 50%;
    background: var(--primary); box-shadow: 0 0 0 3px var(--highlight);
  }

  .fig { margin-top: clamp(3rem, 7vw, 5.5rem); }

  /* NOW strip */
  .now-strip { padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 5rem); position: relative; }
  .rule { display: block; width: calc(100% - var(--gutter)); margin-left: var(--gutter); height: 8px; overflow: visible; }
  .rule path { fill: none; stroke: var(--ink); stroke-width: 1.3; vector-effect: non-scaling-stroke; opacity: 0.7; }
  .now-row { display: grid; grid-template-columns: var(--gutter) 1fr; align-items: baseline; margin-top: 1.4rem; }
  .gutter-label { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  .now-items { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem 0; font-size: clamp(1.05rem, 1.6vw, 1.3rem); color: var(--ink); }
  .now-items li { display: inline-flex; align-items: center; }
  .now-items li + li::before { content: '/'; color: var(--ink-soft); margin: 0 1.1rem; font-weight: 300; }
  .now-items a { border-bottom: 1px solid var(--primary); transition: color 0.2s; }
  .now-items a:hover { color: var(--accent-ink); }
  .cursor { display: inline-block; width: 0.5em; height: 1.05em; margin-left: 0.3em; background: var(--primary); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; padding-left: 0; }
    .hero-rail { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: start; }
    .margin-note { margin-top: 1.8rem; }
    .rule { width: 100%; margin-left: 0; }
    .now-row { grid-template-columns: 1fr; gap: 0.75rem; }
  }
  @media (max-width: 560px) {
    .kicker { font-size: 0.7rem; letter-spacing: 0.1em; }
    .hero-rail { grid-template-columns: 1fr; }
    .margin-note { margin-left: 1rem; }
    .now-items { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .now-items li + li::before { display: none; }
    .ctas { gap: 1.25rem; }
  }
</style>
