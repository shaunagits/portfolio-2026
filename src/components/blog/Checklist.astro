---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="checklist">
  {items.map(item => (
    <li class="checklist-item">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="16" height="16" rx="3"/>
        <path d="M4 8l2.5 2.5L12 5.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{item}</span>
    </li>
  ))}
</ul>

<style>
  .checklist {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
    font-size: 15px;
    line-height: 1.5;
    color: var(--c-text);
  }

  .checklist-item svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .checklist-item svg rect {
    fill: var(--primary);
  }
</style>
