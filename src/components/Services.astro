---
const trustItems = [
  {
    title: 'You work directly with me.',
    description: "No account managers, no handoffs, no surprises about who's actually building your thing.",
  },
  {
    title: "I've worked at scale.",
    description: 'Six years at Nike managing programs that reached millions. I bring that same operational rigor to every project.',
  },
  {
    title: 'I build things that work.',
    description: 'Not templates dressed up as custom. Real products, built properly, designed to grow with you.',
  },
];
---

<section class="trust" id="services">
  <div class="container">
    <h2 class="heading-section" data-animate>Why work with me.</h2>

    <ul class="trust-list" role="list">
      {trustItems.map((item, i) => (
        <li class="trust-item" data-animate data-delay={String(i + 1)}>
          <span class="trust-number">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="trust-title">{item.title}</h3>
          <p class="trust-description">{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    padding: var(--section-py) 0;
    background: var(--c-bg-subtle);
  }

  .trust-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .trust-number {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--c-accent) 20%, transparent);
    line-height: 1;
    display: block;
    margin-bottom: 0.5rem;
  }

  .trust-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--c-accent);
    line-height: 1.3;
  }

  .trust-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--c-text-muted);
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .trust-list {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
