---
const { project, index } = Astro.props;
const href = `/work/${project.id}`;
const chips = (project.tools || []).slice(0, 6);
---
<article class="project" data-animate>
  <a class="p-media" href={href} aria-label={project.name}>
    <div class:list={['stage', project.tint]}>
      {project.frame === 'triptych' ? (
        <div class="triptych">
          {[0, 1, 2].map((i) => (
            <div class:list={['phone', i === 1 && 'center']}>
              <div class="phone-shot">
                {project.phoneImages && project.phoneImages[i]
                  ? <img src={project.phoneImages[i]} alt={`${project.name} — screen ${i + 1}`} loading="lazy" />
                  : <span class="phone-ph">screen {i + 1}</span>}
              </div>
            </div>
          ))}
        </div>
      ) : project.frame === 'combo' ? (
        <div class="combo">
          <div class="frame browser laptop">
            <div class="bar"><i></i><i></i><i></i>{project.urlLabel && <em>{project.urlLabel}</em>}</div>
            <div class="shot">{project.laptopImage && <img src={project.laptopImage} alt={`${project.name} — website`} loading="lazy" />}</div>
          </div>
          <div class="phone">
            <div class="phone-shot">{project.phoneImage && <img src={project.phoneImage} alt={`${project.name} — app`} loading="lazy" />}</div>
          </div>
        </div>
      ) : project.frame === 'browser' ? (
        <div class="frame browser">
          <div class="bar"><i></i><i></i><i></i>{project.urlLabel && <em>{project.urlLabel}</em>}</div>
          <div class="shot">{project.image && <img src={project.image} alt={project.name} loading="lazy" />}</div>
        </div>
      ) : (
        <div class="frame photo">
          <div class="shot">{project.image && <img src={project.image} alt={project.name} loading="lazy" />}</div>
        </div>
      )}
    </div>
  </a>
  <div class="p-body">
    <div class="p-tag">{project.category}</div>
    <h3 class="heading-card"><a href={href}>{project.name}</a></h3>
    <p class="p-summary">{project.summary}</p>
    <ul class="p-stack" aria-label="Tools">
      {chips.map((t) => <li class="chip">{t}</li>)}
    </ul>
    <a href={href} class="p-link">Read the case study →</a>
  </div>
</article>

<style>
  .project { display: grid; grid-template-columns: 1fr 1.05fr; gap: 3.5rem; align-items: center; padding: 4rem 0; border-top: 1px solid var(--line); }
  .project:nth-child(even) .p-media { order: 2; }
  .p-media { display: block; }
  .stage {
    position: relative; aspect-ratio: 4/3; border-radius: var(--radius); overflow: hidden;
    border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; padding: 28px;
    transition: transform 0.55s var(--ease), box-shadow 0.55s var(--ease);
  }
  .stage.tint-teal { background: #e7e2d6; }
  .stage.tint-sand { background: #ece4d6; }
  .stage.tint-cream { background: #efe9db; }
  .project:hover .stage { transform: translateY(-5px); box-shadow: var(--shadow-media); }
  .frame { width: 100%; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 16px 34px -16px rgba(20,55,58,0.45); }
  .frame .shot { background: linear-gradient(135deg,#fbfaf6,#ece6da); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .frame .shot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .frame.browser .bar { height: 28px; display: flex; align-items: center; gap: 6px; padding: 0 12px; background: #f1ede4; border-bottom: 1px solid var(--line); }
  .frame.browser .bar i { width: 8px; height: 8px; border-radius: 50%; background: #cec7b8; display: block; }
  .frame.browser .bar em { margin-left: 12px; font-family: var(--font-mono); font-size: 9px; color: var(--ink-soft); font-style: normal; letter-spacing: 0.04em; }
  .frame.browser .shot { aspect-ratio: 16/10; }
  .frame.photo .shot { aspect-ratio: 4/3; }

  /* combo: website (laptop/browser) + overlapping phone */
  .combo { position: relative; width: 100%; height: 100%; }
  .combo .laptop {
    position: absolute; top: 50%; right: 0; transform: translateY(-50%);
    width: 82%; margin: 0;
  }
  .combo .laptop .shot img { object-position: top; }
  .combo .phone {
    position: absolute; bottom: 4%; left: 0; z-index: 2;
    width: 26%; padding: 5px;
    background: #15181b; border-radius: 20px;
    border: 1px solid rgba(20,55,58,0.25);
    box-shadow: 0 20px 38px -14px rgba(20,55,58,0.55);
  }
  .combo .phone .phone-shot {
    aspect-ratio: 9/19; border-radius: 15px; overflow: hidden; background: #fff;
  }
  .combo .phone .phone-shot img {
    width: 100%; height: 100%; object-fit: cover; object-position: top; display: block;
  }
  @media (max-width: 520px) {
    .combo .phone { width: 30%; }
  }

  /* triptych: three phones, center raised — placeholders ready for screenshots */
  .triptych {
    position: relative; width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center; gap: 1.5%;
  }
  .triptych .phone {
    flex: 0 0 auto; width: 26%; padding: 5px;
    background: #15181b; border-radius: 20px;
    border: 1px solid rgba(20,55,58,0.25);
    box-shadow: 0 16px 32px -16px rgba(20,55,58,0.5);
    z-index: 2;
  }
  .triptych .phone:first-child { transform: rotate(-5deg) translateY(4%); }
  .triptych .phone:last-child { transform: rotate(5deg) translateY(4%); }
  .triptych .phone.center {
    width: 29%; z-index: 3; transform: translateY(-4%);
    box-shadow: 0 24px 44px -16px rgba(20,55,58,0.6);
  }
  .triptych .phone-shot {
    aspect-ratio: 9/19; border-radius: 15px; overflow: hidden; background: #fff;
    display: flex; align-items: center; justify-content: center;
  }
  .triptych .phone-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .triptych .phone-ph {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-soft); opacity: 0.5;
  }
  .p-tag { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.125rem; }
  .p-body h3 { margin-bottom: 1.125rem; }
  .p-body h3 a { transition: color 0.2s; }
  .p-body h3 a:hover { color: var(--primary); }
  .p-summary { color: var(--ink-soft); font-size: 1rem; max-width: 48ch; line-height: 1.6; }
  .p-stack { margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-family: var(--font-mono); font-size: 11px; padding: 5px 11px; border: 1px solid var(--line); border-radius: var(--radius-pill); color: var(--ink-soft); transition: border-color 0.2s, color 0.2s; }
  .chip:hover { border-color: var(--primary); color: var(--primary); }
  .p-link { margin-top: 1.625rem; display: inline-flex; align-items: center; gap: 8px; color: var(--primary); font-weight: 500; font-size: 0.875rem; border-bottom: 1px solid transparent; transition: border-color 0.2s, gap 0.2s var(--ease); }
  .p-link:hover { border-color: var(--primary); gap: 12px; }
  @media (max-width: 860px) {
    .project { grid-template-columns: 1fr; gap: 1.75rem; padding: 3rem 0; }
    .project:nth-child(even) .p-media { order: 0; }
  }
</style>
