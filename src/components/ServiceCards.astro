---
const services = [
  {
    num: '/ 01', title: 'Websites',
    body: 'From brochure sites to content-rich builds. Designed with intention, built to last, and easy for you to manage.',
    icon: 'globe',
  },
  {
    num: '/ 02', title: 'Web Apps & Portals',
    body: "Custom tools built around your actual workflow. If the software doesn't exist for your problem, I'll build it.",
    icon: 'window',
  },
  {
    num: '/ 03', title: 'AI-Powered Tools',
    body: 'Practical AI integrations that save time and cut manual work. Not hype — real tools that do real things.',
    icon: 'ai',
  },
];
---
<section class="services" id="services">
  <div class="container">
    <div class="sec-head" data-animate>
      <h2 class="heading-section"><span class="idx">03 —</span> What I build.</h2>
      <p class="sec-lead">Three ways I help — always designed and built by the same hands.</p>
    </div>
    <div class="svc-grid" data-animate data-delay="1">
      {services.map((s) => (
        <div class="svc">
          <div class="svc-top">
            <span class="svc-ic" set:html={{
              globe: '<svg viewBox="0 0 24 24"><circle class="f" cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.4 2.3 3.7 5.3 3.7 8.5S14.4 18.2 12 20.5c-2.4-2.3-3.7-5.3-3.7-8.5S9.6 5.8 12 3.5z"/></svg>',
              window: '<svg viewBox="0 0 24 24"><rect class="f" x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9h18"/><path d="M6 6.7h.01"/></svg>',
              ai: '<svg viewBox="0 0 24 24"><path class="f" d="M12 4l1.7 4.6L18 10l-4.3 1.4L12 16l-1.7-4.6L6 10l4.3-1.4z"/><path d="M18.5 15l.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6-1.6-.6 1.6-.6z"/></svg>',
            }[s.icon]} />
            <span class="num">{s.num}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding: var(--section-py) 0; position: relative; z-index: 2; }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; margin-bottom: 3.5rem; flex-wrap: wrap; }
  .sec-head .idx { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; color: var(--accent-ink); }
  .sec-lead { max-width: 46ch; color: var(--ink-soft); font-size: 1rem; }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .svc { background: var(--paper); padding: 2.5rem 2.125rem; transition: background 0.3s var(--ease); }
  .svc:hover { background: var(--paper-2); }
  .svc-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.375rem; }
  .svc .num { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-ink); }
  .svc-ic { width: 38px; height: 38px; border-radius: 11px; background: rgba(var(--primary-rgb),0.12); display: flex; align-items: center; justify-content: center; }
  .svc-ic :global(svg) { width: 20px; height: 20px; }
  .svc-ic :global(svg *) { fill: none; stroke: var(--primary); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .svc-ic :global(svg .f) { fill: var(--primary); fill-opacity: 0.15; }
  .svc h3 { font-family: var(--font-display); font-weight: 500; font-size: 1.44rem; margin-bottom: 0.75rem; }
  .svc p { color: var(--ink-soft); font-size: 0.94rem; line-height: 1.6; }
  @media (max-width: 860px) { .svc-grid { grid-template-columns: 1fr; } }
</style>
