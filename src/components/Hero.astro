---
---
<section class="hero" aria-label="Introduction">
  <div class="hero-inner container">
    <div class="status" data-animate><span class="dot"></span>Available for new projects</div>
    <p class="mono hero-eyebrow" data-animate data-delay="1">Designer &middot; Developer &middot; AI App Builder</p>
    <h1 class="hero-title" data-animate data-delay="2">I <em>build</em> websites, web apps, <span class="nb">&amp; AI tools</span></h1>
    <p class="hero-subhead" data-animate data-delay="3">Designer and developer. I take websites, web apps, and AI tools from idea to live for founders, small teams, and nonprofits — no handoffs, no runaround.</p>
    <div class="hero-ctas" data-animate data-delay="4">
      <a href="#work" class="btn btn-primary">See the Work</a>
      <a href="#contact" class="btn">Work With Me</a>
    </div>
    <div class="hero-meta" data-animate data-delay="5">
      <div class="stat"><div class="n">10+</div><div class="l">Years experience</div></div>
      <div class="stat"><div class="n">50+</div><div class="l">Projects shipped</div></div>
      <div class="stat"><div class="n">Nike &middot; Apple</div><div class="l">Production background</div></div>
      <div class="stat"><div class="n">Hawai&#699;i</div><div class="l">Working remotely</div></div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: 76px; background: #fff; }
  .hero-inner { padding-top: clamp(4rem, 8vw, 6rem); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
  .status {
    display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-mono);
    font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink);
    border: 1px solid var(--line); background: var(--paper); padding: 6px 13px 6px 11px;
    border-radius: var(--radius-pill); margin-bottom: 1.6rem;
  }
  .status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--primary); position: relative; }
  .status .dot::after { content: ''; position: absolute; inset: -3px; border-radius: 50%; background: var(--primary); opacity: 0.35; animation: pulse 2.4s var(--ease) infinite; }
  @keyframes pulse { 0% { transform: scale(1); opacity: 0.4; } 70% { transform: scale(2.4); opacity: 0; } 100% { opacity: 0; } }
  .hero-eyebrow { color: var(--accent-ink); margin-bottom: 1.9rem; display: flex; align-items: center; gap: 14px; }
  .hero-eyebrow::before { content: ''; width: 36px; height: 1px; background: var(--primary); }
  .hero-title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2.5rem, 6.4vw, 5.5rem); line-height: 1.0; letter-spacing: -0.025em; max-width: 20ch;
  }
  /* keeps "& AI tools" together so it wraps to line 2 as one unit */
  .hero-title .nb { white-space: nowrap; }
  .hero-title em { font-style: normal; color: var(--primary); position: relative; }
  .hero-title em::after { content: ''; position: absolute; left: 0; bottom: 0.04em; height: 0.07em; width: 0; background: var(--accent); border-radius: 3px; transition: width 0.9s 0.35s var(--ease); }
  .hero-title.is-visible em::after { width: 100%; }
  .hero-subhead { margin-top: 2rem; max-width: 52ch; font-size: clamp(1.06rem, 2vw, 1.3rem); color: var(--ink-soft); line-height: 1.55; }
  .hero-ctas { margin-top: 2.75rem; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .hero-meta { margin-top: 5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; border-top: 1px solid var(--line); padding-top: 2rem; }
  .hero-meta .n { font-family: var(--font-display); font-size: 2.1rem; font-weight: 500; line-height: 1; color: var(--primary); }
  .hero-meta .l { margin-top: 0.5rem; color: var(--ink-soft); font-size: 0.85rem; }
  @media (max-width: 860px) { .hero-meta { grid-template-columns: 1fr 1fr; gap: 1.75rem 1rem; } }
  @media (prefers-reduced-motion: reduce) { .hero-title em::after { width: 100%; } }
</style>
