---
/** Phone around a 390x844 @2x screenshot. Radii scale with the phone's own width (cq units). */
interface Props { src: string; alt: string; class?: string; loading?: 'lazy' | 'eager' }
const { src, alt, class: className, loading = 'lazy' } = Astro.props;
---
<div class:list={['phone', className]}>
  <div class="phone-body"><div class="phone-screen"><img src={src} alt={alt} width="780" height="1688" loading={loading} decoding="async" /></div></div>
</div>
<style>
  .phone { container-type: inline-size; aspect-ratio: 780 / 1688; }
  .phone-body { width: 100%; height: 100%; padding: 3.2cqw; border-radius: 13cqw; background: var(--deep); box-shadow: 0 30px 60px -28px rgba(var(--shadow-rgb), 0.55); }
  .phone-screen { width: 100%; height: 100%; border-radius: 10cqw; overflow: hidden; background: var(--card); }
  .phone-screen img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
</style>
