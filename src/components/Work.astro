---
import ProjectCard from './ProjectCard.astro';
import projects from '../data/projects.json';
---
<section class="work" id="work">
  <div class="container">
    <div class="work-header" data-animate>
      <h2 class="heading-section"><span class="idx">01 —</span> Selected work.</h2>
      <p class="work-subhead">Real problems, real solutions — built for people who needed something that didn't already exist.</p>
    </div>
    <div class="projects-list">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </div>
</section>

<style>
  .work { padding: var(--section-py) 0; }
  .work-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; margin-bottom: 3.5rem; flex-wrap: wrap; }
  .work-header .idx { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; color: var(--accent); }
  .work-subhead { max-width: 46ch; color: var(--ink-soft); font-size: 1rem; }
  .projects-list { display: flex; flex-direction: column; }
</style>
