---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="foot-top">
      <div>
        <div class="foot-logo">Shauna<span>.</span></div>
        <p>Designer &amp; developer building websites, web apps, and AI tools from Hawai&#699;i.</p>
      </div>
      <div class="foot-col">
        <div class="mono">Index</div>
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#services">Services</a>
        <a href="/#contact">Work With Me</a>
      </div>
      <div class="foot-col">
        <div class="mono">Elsewhere</div>
        <a href="/blog"><svg class="line" viewBox="0 0 24 24"><path d="M6 3.5h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9.5 9h5"/><path d="M9.5 12.5h5"/></svg>Writing</a>
        <a href="https://www.linkedin.com/in/shaunaarnold/" aria-label="LinkedIn"><svg class="brand" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>LinkedIn</a>
        <a href="https://github.com/shaunagits" aria-label="GitHub"><svg class="brand gh" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>GitHub</a>
      </div>
    </div>
    <div class="foot-bottom">
      <div class="mono">© {year} Shauna</div>
      <div class="mono">Designed &amp; built in Hawai&#699;i</div>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--primary-deep); color: var(--on-dark); padding: 4.5rem 0 2.5rem; position: relative; z-index: 2; }
  .foot-top { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; border-bottom: 1px solid var(--on-dark-line); }
  .foot-logo { font-family: var(--font-display); font-size: 1.875rem; font-weight: 600; }
  .foot-logo span { color: var(--accent); }
  .foot-top p { color: var(--on-dark-2); margin-top: 1rem; max-width: 34ch; font-size: 0.94rem; }
  .foot-col .mono { color: var(--on-dark-3); margin-bottom: 1.125rem; }
  .foot-col a { display: flex; align-items: center; gap: 10px; color: var(--on-dark); font-size: 0.94rem; margin-bottom: 0.75rem; transition: color 0.2s; }
  .foot-col a:hover { color: var(--accent); }
  .foot-col a svg { width: 17px; height: 17px; opacity: 0.9; }
  .foot-col a svg.line { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .foot-col a svg.brand { fill: currentColor; stroke: none; }
  .foot-col a svg.gh { width: 16px; height: 16px; }
  .foot-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 1.75rem; flex-wrap: wrap; gap: 0.875rem; }
  .foot-bottom .mono { color: var(--on-dark-3); }
  @media (max-width: 720px) { .foot-top { grid-template-columns: 1fr; } }
</style>
