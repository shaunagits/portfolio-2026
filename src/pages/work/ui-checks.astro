---
/**
 * Case study: turning design-system rules into automated UI checks, and testing them
 * on Claude. Every terminal block is a real run, saved in src/data/check-runs/.
 * The two cards were built by fresh Claude sessions that saw only DESIGN.md.
 */
import LayoutV2 from '../../layouts/LayoutV2.astro';
import { checks } from '../../data/checks';
import runFirst from '../../data/check-runs/run-first.txt?raw';
import runHover from '../../data/check-runs/run-hover.txt?raw';
import run1 from '../../data/check-runs/run1.txt?raw';
import run2 from '../../data/check-runs/run2.txt?raw';
import run3 from '../../data/check-runs/run3.txt?raw';
import tokens from '../../../tokens/tokens.json';

const typeCount = Object.keys(tokens.type).filter((k) => !k.startsWith('$')).length;
const meta = [['Role', 'Rules, checks and the fixes'], ['Year', '2026'], ['Where', 'shauna.dev and the rescue admin app'], ['Status', 'Runs on every build']];
const how = [
  'Every text colour is paired with every surface it sits on, and the ratio is computed from the tokens. The reef accent is flagged anywhere it is used as text.',
  'No raw hex or rgb values in style code, and every font size must be a type token.',
  'Reads every built page: button labels in Title Case, and no em dashes anywhere in the copy.',
  'Every image has alt text, and every link and button has a visible label or an aria-label.',
  'A reduced-motion rule exists, autoplaying video has a pause button, and no transition uses a raw duration.',
  'Anything that moves on hover must be a link or a button.',
];
const rules = checks.map((c, i) => [c, how[i]]);
const term = (s: string) => s.split('\n').map((l) => ({ l, bad: l.startsWith('✗') || l.startsWith('    ') || /failed/.test(l), ok: l.startsWith('✓') || /All checks passed/.test(l) }));
const steps = [
  { n: '01', t: 'A fresh Claude session builds a card', d: 'It saw only DESIGN.md: no code, no other files. I asked for a “Book a session” card with a label, heading, price, list, icon, two actions and a little motion. The offer is made up; it exists for the test.' },
  { n: '02', t: 'Every check passes', d: 'Tokens for colour and spacing, Title Case buttons, an accessible icon, reduced motion handled. By the rules as written, the card was perfect.', run: run1 },
  { n: '03', t: 'I review it anyway, and find two problems', d: 'Every font size was typed by hand, because the rules named seven sizes but never made them tokens, so nothing could check them. And the whole card lifted on hover, promising a click it couldn’t keep. No rule covered that.', img: '/images/v2/checks/claude-card-run1.jpg', w: 880, h: 852, alt: 'The first card Claude built: label, heading, price, three bullet points, a Book a Session button and a See Past Work link' },
  { n: '04', t: 'I ask the same question of my own site', d: 'The rules said seven sizes. The site used 32 different font sizes across 108 declarations. Claude hadn’t broken the system; it had found the part of it that only existed in prose.' },
  { n: '05', t: 'I fix the system, not the card', d: `A real type scale: ${typeCount} sizes, each a token. A check that fails the build on any other font size, then every size on the site moved onto the scale. A new rule in DESIGN.md, and a check to match: only links and buttons move on hover. That check immediately caught my own System page, where icon tiles lifted on hover.` },
  { n: '06', t: 'The first card now fails', d: 'Same card, stronger checks: eight problems, each one pointing at a file and a line.', run: run2 },
  { n: '07', t: 'A new Claude session, the updated rules', d: 'Same request, same blank slate, but the new DESIGN.md. Type tokens throughout, no hover lift on the card, every check passing.', run: run3, img: '/images/v2/checks/claude-card-run3.jpg', w: 960, h: 912, alt: 'The second card Claude built: the same content using type tokens, with no hover lift on the card' },
];
---
<LayoutV2 title="Can a design system check itself? · Case study · Shauna Arnold" description="Turning design-system rules into automated UI checks, then testing them on Claude: the checks passed, I found their blind spot, and fixed the system so it can’t come back.">
  <article>
    <header class="cs-top wrap">
      <a class="back meta" href="/#work">← All work</a>
      <div class="cs-head">
        <div>
          <p class="label">Case study · Quality</p>
          <h1 data-xray="display-xl">Can a design system check itself?</h1>
        </div>
        <p class="cs-lede">My design rules are written for people and for Claude. Then they become a build step: if a page breaks a rule, the site won’t build, whoever wrote it. Here is how that works, what it caught, and what it missed.</p>
      </div>
      <dl class="cs-meta">{meta.map(([k, v]) => <div><dt class="meta">{k}</dt><dd>{v}</dd></div>)}</dl>
    </header>

    <section class="sec sec--rule wrap" aria-labelledby="r-h">
      <div class="sec-head">
        <div><p class="label">01 · Rule to check</p><h2 class="h2" id="r-h">Six rules a machine can hold me to.</h2></div>
        <p class="muted">Each rule lives in DESIGN.md in plain words. The same rule lives in a script that runs after every build and fails it on a break.</p>
      </div>
      <ol class="rules">{rules.map(([r, h], i) => <li><span class="nl-n">0{i + 1}</span><div><h3>{r}</h3><p class="muted">{h}</p></div></li>)}</ol>
    </section>

    <section class="sec sec--sand" aria-labelledby="f-h">
      <div class="wrap">
        <div class="sec-head">
          <div><p class="label">02 · Real failures</p><h2 class="h2" id="f-h">It stops me, too.</h2></div>
          <p class="muted">These are real runs from building this site. A failure isn’t always a bug: sometimes it’s a decision a person has to make, and then write down.</p>
        </div>
        <div class="fails">
          <div class="fail">
            <pre class="term" tabindex="0" aria-label="Check output: three files use the reef accent as text">{term(runFirst).map((x) => <span class:list={[x.bad && 'bad', x.ok && 'ok']}>{x.l + '\n'}</span>)}</pre>
            <div><h3>The first run failed.</h3><p class="muted">The logo mark, the accent full stop and the little arrows all used the reef accent, which is too light for text. But they aren’t text: they’re graphics, where 3:1 is enough. So the decision went into the code as a marked exception, where the next person, or Claude, will see it.</p></div>
          </div>
          <div class="fail">
            <pre class="term" tabindex="0" aria-label="Check output: icon tiles on the System page move on hover but are not links">{term(runHover).map((x) => <span class:list={[x.bad && 'bad', x.ok && 'ok']}>{x.l + '\n'}</span>)}</pre>
            <div><h3>A new rule caught old work.</h3><p class="muted">The moment the hover rule existed, it found icon tiles on my System page that lifted when you pointed at them. They aren’t clickable, so now they stay still.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec wrap" aria-labelledby="e-h">
      <div class="sec-head">
        <div><p class="label">03 · The experiment</p><h2 class="h2" id="e-h">What happens when Claude is the one using the system?</h2></div>
        <p class="muted">A design system is now read by people and by models. So I gave mine to a fresh Claude session and let the checks judge the result.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="step-txt"><span class="nl-n">{s.n}</span><h3>{s.t}</h3><p class="muted">{s.d}</p></div>
            {(s.run || s.img) && (
              <div class="step-art">
                {s.img && <img src={s.img} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />}
                {s.run && <pre class="term" tabindex="0" aria-label={`Check output for step ${s.n}`}>{term(s.run).map((x) => <span class:list={[x.bad && 'bad', x.ok && 'ok']}>{x.l + '\n'}</span>)}</pre>}
              </div>
            )}
          </li>
        ))}
      </ol>
      <p class="takeaway">A passing check isn’t proof. The review found the blind spot, and the fix went into the system, so it can’t come back, for people or for Claude.</p>
    </section>

    <section class="sec sec--sand" aria-labelledby="p-h">
      <div class="wrap two">
        <div><p class="label">04 · In a product</p><h2 class="h2" id="p-h">The same idea, on a real app.</h2></div>
        <div class="prod">
          <p>For the rescue’s admin app I wrote a script that counts where the app breaks its own rules: hardcoded colours, names nothing defines, one-off styles. Then I fixed it in batches and re-ran the count after each one.</p>
          <a class="text-link" href="/work/rescue-platform/">Read the Rescue Case Study →</a>
        </div>
      </div>
    </section>

    <section class="nextcs">
      <div class="wrap nextcs-in">
        <div><p class="meta">See the system</p><p class="nextcs-t">Every token, size and rule these checks enforce</p></div>
        <div class="nextcs-b"><a class="btn btn--koa" href="/resume/">View Résumé</a><a class="btn" href="/system/">Open the System Page</a></div>
      </div>
    </section>
  </article>
</LayoutV2>

<style>
  .cs-top { padding-block: var(--space-8) var(--space-7); }
  .back { display: inline-block; margin-bottom: var(--space-6); }
  .cs-head { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--space-7); align-items: end; }
  .cs-head h1 { font-family: var(--font-display); font-weight: 500; font-size: var(--text-display-xl); line-height: 1.02; letter-spacing: -0.03em; margin-top: var(--space-4); text-wrap: balance; }
  .cs-lede { font-size: var(--text-body-l); line-height: 1.6; }
  .cs-meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-8); }
  .cs-meta div { display: flex; flex-direction: column; gap: var(--space-2); padding-top: 14px; border-top: 1px solid var(--line); }

  .sec { padding-block: var(--space-9); }
  .sec--sand { background: var(--sand); }
  .sec--rule { border-top: 1px solid var(--line); }
  .sec-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-6) var(--space-7); align-items: end; margin-bottom: var(--space-7); }
  .sec-head .h2, .two .h2 { margin-top: var(--space-3); }
  .two { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-7); align-items: end; }
  .nl-n { font-family: var(--font-label); font-size: var(--text-small); color: var(--teal-text); }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--text-lead); line-height: 1.2; }

  .rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-7); }
  .rules li { display: grid; grid-template-columns: 40px 1fr; gap: 12px; padding: 20px 0; border-top: 1px solid var(--line); }
  .rules p { margin-top: 6px; }

  .term { background: var(--ink); color: var(--term-text); border-radius: var(--radius-card); padding: var(--space-5); font-family: var(--font-label); font-size: var(--text-small); line-height: 1.6; white-space: pre-wrap; overflow-x: auto; }
  .term .bad { color: var(--white); }
  .term .ok { color: var(--term-ok); }
  .fails { display: grid; gap: var(--space-7); }
  .fail { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-7); align-items: start; }
  .fail h3 { margin-bottom: var(--space-3); }

  .steps { display: grid; gap: var(--space-8); }
  .step { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-7); align-items: start; padding-top: var(--space-6); border-top: 1px solid var(--line); }
  .step-txt { display: flex; flex-direction: column; gap: var(--space-3); }
  .step-art { display: grid; gap: var(--space-4); }
  .step-art img { width: 100%; max-width: 520px; height: auto; border-radius: var(--radius-card); border: 1px solid var(--line); }
  .step:not(:has(.step-art)) .step-txt { grid-column: 1 / -1; max-width: 760px; }
  .takeaway { margin-top: var(--space-8); padding: var(--space-6); border-radius: var(--radius-card); background: var(--reef-tint); font-family: var(--font-display); font-size: var(--text-lead); line-height: 1.35; color: var(--ink); }

  .prod { display: flex; flex-direction: column; gap: var(--space-4); font-size: var(--text-body-l); }

  .nextcs { background: var(--paper); border-top: 1px solid var(--line); padding-block: var(--space-8) var(--space-9); }
  .nextcs-in { display: grid; grid-template-columns: 1fr auto; gap: var(--space-6); align-items: center; }
  .nextcs-t { font-family: var(--font-display); font-size: var(--text-heading); line-height: 1.1; margin-top: var(--space-3); max-width: 820px; }
  .nextcs-b { display: flex; gap: var(--space-5); flex-wrap: wrap; }

  @media (max-width: 979px) {
    .cs-head, .sec-head, .two, .fail, .step, .nextcs-in, .rules { grid-template-columns: 1fr; }
    .cs-head { gap: var(--space-5); }
    .cs-meta { grid-template-columns: 1fr 1fr; gap: var(--space-5); margin-top: var(--space-7); }
    .sec { padding-block: var(--space-8); }
    .fail, .step { gap: var(--space-5); }
    .term { font-size: var(--text-label); }
  }
</style>
