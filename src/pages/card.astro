---
/**
 * Digital business card, served at https://shauna.digital/card.
 *
 * The printed business card's QR code opens THIS URL (decoded and checked
 * 2026-10-06), so the route must never move. What the page shows can change
 * freely; the address cannot without reprinting.
 *
 * Mirrors the printed card: Funnel Display + Funnel Sans (loaded on this page
 * only; the rest of the site keeps its fonts until that swap is decided), the
 * teal slash, mono contact lines, and a dark band like the card's back.
 *
 * All content is in src/data/card.json, which also builds the Save Contact
 * file (/shauna-arnold.vcf). Standalone like links.astro: no Layout.astro, so
 * no nav or scroll bar; only global.css for the shared tokens.
 */
import '../styles/global.css';
import card from '../data/card.json';

const [taglineBefore, taglineAfter] = card.tagline.split(card.taglineAccent);
const canonical = new URL('/card/', Astro.site);
const title = `${card.name} · ${card.title}`;
const description = `${card.name}, ${card.title.toLowerCase()} in ${card.city}. Save my contact, call, text or email.`;

// Official marks from Simple Icons, monochrome via currentColor (same glyphs
// and reasoning as links.astro, see the note there).
const ICONS: Record<string, string> = {
  linkedin: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>`,
  github: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>`,
};

// Line icons for the buttons (inline, so they take this file's scope).
const UI = {
  save: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><path d="M19 8v6M16 11h6"/></svg>`,
  call: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5h3.2l1.6 4.2-2.1 1.3a11 11 0 0 0 7.3 7.3l1.3-2.1 4.2 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z"/></svg>`,
  text: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-4.5 3.5v-3.5H4a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1Z"/></svg>`,
  mail: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6.5 9 6.5 9-6.5"/></svg>`,
  arrow: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <!-- A QR landing page, not a search result: /links and the homepage are the
         pages that should rank. -->
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F2F5F6" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@500;700&family=Funnel+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="cardpage">
    <main class="wrap">
      <article class="front" aria-label="Contact card">
        <span class="slash" aria-hidden="true">/</span>
        <h1>{card.name}</h1>
        <p class="role">{card.title}</p>
        <span class="rule" aria-hidden="true"></span>
        <ul class="lines">
          <li><a href={`mailto:${card.email}`}>{card.email}</a></li>
          <li><a href={`tel:${card.phoneE164}`}>{card.phoneDisplay}</a></li>
          <li><a class="site" href="/">{card.websiteLabel}</a></li>
        </ul>
      </article>

      <div class="actions">
        <a class="btn primary save" href="/shauna-arnold.vcf" download="Shauna-Arnold.vcf">
          <Fragment set:html={UI.save} />Save Contact
        </a>
        <a class="btn" href={`tel:${card.phoneE164}`}><Fragment set:html={UI.call} />Call</a>
        <a class="btn" href={`sms:${card.phoneE164}`}><Fragment set:html={UI.text} />Text</a>
        <a class="btn" href={`mailto:${card.email}`}><Fragment set:html={UI.mail} />Email</a>
      </div>

      <section class="back" aria-label="About my work">
        <p class="tagline">{taglineBefore}<strong>{card.taglineAccent}</strong>{taglineAfter}</p>
        <div class="back-row">
          <a class="work" href="/">See My Work<Fragment set:html={UI.arrow} /></a>
          <ul class="socials">
            {card.socials.map((s) => (
              <li><a class="ico" href={s.href} aria-label={s.label} rel="me noopener" target="_blank"><Fragment set:html={ICONS[s.icon]} /></a></li>
            ))}
          </ul>
        </div>
      </section>

      <p class="foot">{card.city}, Hawaiʻi · <a href="/links/">More links</a></p>
    </main>
  </body>
</html>

<style is:global>
  /* Funnel on THIS page only, to match the printed card. Loaded weights:
     Display 500/700, Sans 400/500, Mono 400/500. Ask only for those. */
  .cardpage {
    --font-display: 'Funnel Display', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    --font-sans: 'Funnel Sans', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    --btn-offset: 5px;
    background: var(--paper-2);
  }
  /* the global paper grain sits above content at z-index 1; not wanted here */
  .cardpage::after { display: none; }
</style>

<style>
  .wrap {
    max-width: 440px; margin: 0 auto;
    padding: calc(20px + env(safe-area-inset-top)) 16px calc(28px + env(safe-area-inset-bottom));
    display: grid; gap: 14px;
  }

  /* ---------- front: mirrors the printed card ---------- */
  .front {
    background: var(--paper); border: 1px solid var(--line); border-radius: 18px;
    padding: 26px 26px 28px;
    box-shadow: 0 18px 40px -24px rgba(var(--ink-rgb), 0.35);
  }
  .slash {
    display: block; font-family: var(--font-display); font-weight: 700;
    font-size: 1.9rem; line-height: 1; color: var(--primary); margin-bottom: 18px;
  }
  h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.9rem, 8.5vw, 2.3rem); line-height: 1.05; letter-spacing: -0.02em;
  }
  .role { margin-top: 8px; font-size: 1.05rem; color: var(--ink-soft); }
  .rule { display: block; width: 34px; height: 2px; background: var(--primary); margin: 20px 0 16px; }
  .lines { display: grid; gap: 6px; }
  .lines a {
    font-family: var(--font-mono); font-size: 0.95rem; color: var(--ink);
    display: inline-block; padding: 3px 0; border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .lines a.site { color: var(--accent-ink); }
  .lines a:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  @media (hover: hover) { .lines a:hover { border-color: currentColor; } }

  /* ---------- actions: the site's offset-shape buttons ---------- */
  .actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 6px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 50px; padding: 0 10px;
    border: 1.5px solid var(--ink); border-radius: 14px;
    background: var(--paper); color: var(--ink);
    font-family: var(--font-sans); font-size: 0.95rem; font-weight: 500; white-space: nowrap;
    box-shadow: var(--btn-offset) calc(var(--btn-offset) * -1) 0 0 var(--ink);
    transition: box-shadow 0.3s var(--ease), background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .btn :global(svg) { width: 18px; height: 18px; flex: none; }
  .btn.primary {
    grid-column: 1 / -1; min-height: 56px; font-size: 1.05rem;
    border-color: var(--primary);
    box-shadow: var(--btn-offset) calc(var(--btn-offset) * -1) 0 0 var(--primary);
  }
  .btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  .btn:active, .btn:focus-visible { box-shadow: 0 0 0 0 var(--ink); background: var(--ink); color: var(--paper); }
  /* --accent-ink, not --primary, behind white text: #2C8C99 is only 3.95:1. */
  .btn.primary:active, .btn.primary:focus-visible { background: var(--accent-ink); border-color: var(--accent-ink); color: var(--paper); box-shadow: 0 0 0 0 var(--primary); }
  @media (hover: hover) {
    .btn:hover { box-shadow: 0 0 0 0 var(--ink); background: var(--ink); color: var(--paper); }
    .btn.primary:hover { box-shadow: 0 0 0 0 var(--primary); background: var(--accent-ink); border-color: var(--accent-ink); }
  }

  /* ---------- back: the card's dark side ---------- */
  .back {
    margin-top: 6px; background: var(--ink); color: var(--on-dark);
    border-radius: 18px; padding: 26px 26px 22px;
  }
  .tagline {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.35rem, 6vw, 1.6rem); line-height: 1.2; letter-spacing: -0.01em;
    text-wrap: balance;
  }
  /* lighter teal on ink, like the printed card's back (a tint of --primary, so
     still the one accent) */
  .tagline strong { font-weight: 700; color: color-mix(in srgb, var(--primary) 72%, var(--paper)); }
  .back-row { margin-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .work {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px;
    border-radius: var(--radius-pill); background: var(--paper); color: var(--ink);
    font-size: 0.95rem; font-weight: 500;
    transition: gap 0.2s var(--ease);
  }
  .work :global(svg) { width: 16px; height: 16px; }
  .work:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  @media (hover: hover) { .work:hover { gap: 12px; } }
  .socials { display: flex; gap: 4px; }
  .ico {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    color: var(--on-dark); transition: background 0.2s var(--ease);
  }
  /* set:html SVGs never get this file's scope attribute: :global() is required
     or the icon computes to 0x0 (CLAUDE.md). */
  .ico :global(svg) { width: 20px; height: 20px; display: block; }
  .ico:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }
  @media (hover: hover) { .ico:hover { background: rgba(var(--paper-rgb), 0.12); } }

  .foot { text-align: center; font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-soft); margin-top: 6px; }
  .foot a { color: var(--accent-ink); border-bottom: 1px solid currentColor; }
</style>
