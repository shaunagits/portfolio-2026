  pinterest: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>`,
  substack: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>`,
  whatsapp: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>`,
  github: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>`,
};

// Small line icons for the rows and buttons. Inline markup, so they get this
// file's scope and need no :global() size rule.
const UI = {
  mail: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6.5 9 6.5 9-6.5"/></svg>`,
  globe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.6 2.7 3.9 5.9 3.9 9.5s-1.3 6.8-3.9 9.5c-2.6-2.7-3.9-5.9-3.9-9.5S9.4 5.2 12 2.5Z"/></svg>`,
};

const title = 'Shauna Arnold · Designer and developer';
const description =
  'Shauna Arnold takes websites, web apps and AI tools from idea to live, from Honolulu. Recent work, and how to get in touch.';
const canonical = 'https://shauna.dev/links/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://shauna.dev/images/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://shauna.dev/images/og-image.jpg" />
    <meta name="theme-color" content="#F2F5F6" />
  </head>

  <body class="links-page">
    <main class="wrap">
      <article class="card">
        <!-- MOSAIC: first three gallery entries. Buttons, not links: they open
             the viewer, they don't navigate. -->
        <div class={`mosaic n${tiles.length}`}>
          {
            tiles.map((g, i) => (
              <button
                class={`tile t${i}`}
                type="button"
                data-open={i}
                aria-label={i === 2 && more ? `${g.title}, and ${more} more. Open gallery` : `${g.title}. Open gallery`}
              >
                <img src={g.src} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" width="1440" height="900" />
                {!(i === 2 && more > 0) && <span class="tag-name" aria-hidden="true">{g.title}</span>}
                {i === 2 && more > 0 && <span class="more" aria-hidden="true">+{more}</span>}
              </button>
            ))
          }
        </div>

        <div class="body">
          <div class="id-row">
            <div class="avatar">
              <img src={profile.photo} alt={profile.photoAlt} width="192" height="192" />
              {
                profile.verified && (
                  <span class="badge" title="Verified" aria-label="Verified">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1.5 14.6 3.4l3.2-.2.9 3.1 2.7 1.8-1 3.1 1 3.1-2.7 1.8-.9 3.1-3.2-.2L12 21.9 9.4 20l-3.2.2-.9-3.1-2.7-1.8 1-3.1-1-3.1 2.7-1.8.9-3.1 3.2.2L12 1.5Z"/><path d="m8 12.2 2.7 2.7L16.2 9.4" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                )
              }
            </div>
            <ul class="socials" aria-label="Find me on">
              {
                socials.map((s) => (
                  <li>
                    <a class="ico" href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                      <Fragment set:html={ICONS[s.icon]} />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <h1>{profile.name}</h1>
          <ul class="chips">
            {profile.tags.map((t) => <li>{t}</li>)}
          </ul>

          <p class="bio">{profile.bio}</p>

          <ul class="meta">
            <li class="status"><span class="dot" aria-hidden="true"></span>{profile.status}</li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 3 3 10.5l7.5 3L13.5 21 21 3Z"/></svg>
              {profile.location}
            </li>
          </ul>

          <div class="actions">
            {
              actions.map((a) => (
                <a class={`btn${a.primary ? ' primary' : ''}`} href={a.href}>
                  <Fragment set:html={UI[a.icon]} />
                  {a.label}
                </a>
              ))
            }
          </div>
        </div>
      </article>

      <footer>{footerLine}</footer>
    </main>

    <!-- VIEWER: a native <dialog>, so focus trapping, Esc to close and the
         backdrop come from the browser, not from script. -->
    <dialog class="viewer" aria-label="Work gallery">
      <div class="v-top">
        <span class="v-count" aria-live="polite"></span>
        <button class="v-close" type="button" aria-label="Close gallery">✕</button>
      </div>
      <div class="v-stage">
        <button class="v-nav prev" type="button" aria-label="Previous">‹</button>
        <img class="v-img" alt="" />
        <button class="v-nav next" type="button" aria-label="Next">›</button>
      </div>
      <div class="v-cap">
        <div>
          <p class="v-title"></p>
          <p class="v-text"></p>
        </div>
        <a class="v-visit" target="_blank" rel="noopener">Visit site ↗</a>
      </div>
    </dialog>

    <script type="application/json" id="gallery-data" set:html={JSON.stringify(gallery.map(({ src, title, caption, href }) => ({ src, title, caption, href })))} />
    <script>
      const items = JSON.parse(document.getElementById('gallery-data')!.textContent || '[]');
      const dlg = document.querySelector('.viewer') as HTMLDialogElement;
      const img = dlg.querySelector('.v-img') as HTMLImageElement;
      const count = dlg.querySelector('.v-count')!;
      const ttl = dlg.querySelector('.v-title')!;
      const txt = dlg.querySelector('.v-text')!;
      const visit = dlg.querySelector('.v-visit') as HTMLAnchorElement;
      let at = 0;

      function show(i: number) {
        at = (i + items.length) % items.length;
        const g = items[at];
        img.src = g.src;
        img.alt = `${g.title} screenshot`;
        count.textContent = `${at + 1} / ${items.length}`;
        ttl.textContent = g.title;
        txt.textContent = g.caption || '';
        if (g.href) { visit.href = g.href; visit.hidden = false; } else { visit.hidden = true; }
        // warm the next image so paging feels instant
        const n = items[(at + 1) % items.length];
        if (n) new Image().src = n.src;
      }

      document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
        b.addEventListener('click', () => { show(Number(b.dataset.open)); dlg.showModal(); }),
      );
      dlg.querySelector('.prev')!.addEventListener('click', () => show(at - 1));
      dlg.querySelector('.next')!.addEventListener('click', () => show(at + 1));
      dlg.querySelector('.v-close')!.addEventListener('click', () => dlg.close());
      // a click on the backdrop (the dialog itself, not its contents) closes
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(at - 1);
        if (e.key === 'ArrowRight') show(at + 1);
      });
      // swipe on touch
      let x0: number | null = null;
      const stage = dlg.querySelector('.v-stage')!;
      stage.addEventListener('touchstart', (e) => { x0 = (e as TouchEvent).touches[0].clientX; }, { passive: true });
      stage.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = (e as TouchEvent).changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1));
        x0 = null;
      });
      if (items.length < 2) dlg.querySelectorAll('.v-nav').forEach((b) => ((b as HTMLElement).hidden = true));
    </script>
  </body>
</html>

<style>
  .links-page {
    --btn-offset: 4px;
    background: var(--paper-2);
    color: var(--ink);
    line-height: 1.5;
    min-height: 100vh;
    -webkit-tap-highlight-color: transparent;
  }
  .wrap {
    max-width: 440px;
    margin: 0 auto;
    /* padding-block/inline, not the shorthand — see CLAUDE.md */
    padding-block: clamp(14px, 5vw, 48px) calc(28px + env(safe-area-inset-bottom));
    padding-inline: 14px;
  }

  /* ---------- card ---------- */
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 10px;
    box-shadow: 0 1px 2px rgba(var(--ink-rgb), 0.05), 0 18px 40px -24px rgba(var(--ink-rgb), 0.35);
  }

  /* ---------- mosaic ---------- */
  .mosaic {
    display: grid; gap: 6px;
    grid-template-columns: 1.7fr 1fr;
    grid-template-rows: 1fr 1fr;
    height: clamp(190px, 52vw, 230px);
    border-radius: 15px; overflow: hidden;
  }
  .mosaic.n1 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .mosaic.n2 { grid-template-rows: 1fr; }
  .tile {
    position: relative; overflow: hidden; padding: 0; border: 0;
    background: var(--primary-100); cursor: zoom-in;
  }
  .t0 { grid-row: 1 / -1; }
  .tile img {
    width: 100%; height: 100%; display: block;
    object-fit: cover; object-position: top left;
    transition: transform 0.5s var(--ease);
  }
  .tag-name {
    position: absolute; left: 7px; bottom: 7px;
    font-family: var(--font-sans); font-size: 0.66rem; font-weight: 600;
    background: rgba(var(--ink-rgb), 0.78); color: var(--paper);
    padding: 3px 8px; border-radius: 6px;
    max-width: calc(100% - 14px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  /* The avatar overlaps the big tile's lower-left corner, so its label sits
     top-left instead. */
  .t0 .tag-name { bottom: auto; top: 7px; }
  .more {
