---
/**
 * Link-in-bio page, served at https://shauna.dev/links/.
 *
 * Returned to this repo 2026-08-19 when the portfolio took over shauna.dev as
 * its primary domain. Content is driven by src/data/links.json: adding a link
 * means adding one entry to a group there.
 *
 * Redesigned 2026-09-26 as a single centred column: photo, "Hi, I'm Shauna.
 * Let's talk about...", then GROUPED links whose headings finish that
 * sentence. Top portion follows the reference layout Shauna supplied:
 * home + contact pill, photo, name, bio, social icons inline. The old masthead (logomark, wordmark,
 * "Selected links / shauna.dev") and the tinted contact band are gone. "Get in
 * touch" is now the first bar in the "your project" group instead of a pill
 * beside the icons, so every button on the page shares one width and one edge.
 *
 * Deliberately standalone: no Layout.astro (that carries the portfolio nav and
 * the scroll-progress bar). Only global.css is imported, so the design tokens
 * stay single-sourced.
 */
import '../styles/global.css';
import { getCollection } from 'astro:content';
import links from '../data/links.json';

const { meta, intro, socials, groups } = links;

// --- Writing group: derived from the blog collection --------------------
// Two posts share publishedDate 2026-07-27, so a date sort alone cannot decide
// "latest". links.json pins the slug; date order is the fallback if the pin is
// removed or the file is renamed. The title always comes from the post's own
// frontmatter, so the page and the blog can never show one article two ways.
const writing = groups.find((g) => g.kind === 'writing');
const posts = await getCollection('blog');
const newestFirst = [...posts].sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
const latest = posts.find((p) => p.id === writing?.latestPostSlug) ?? newestFirst[0];

// Normalise every group to one item shape, so the markup has ONE bar renderer.
// Two renderers for the same bar is how one of them ends up subtly wrong.
const rendered = groups.map((g) =>
  g.kind === 'writing'
    ? {
        heading: g.heading,
        items: [
          { title: latest.data.title, desc: g.latestDesc, href: `/blog/${latest.id}`, variant: 'plain', long: true },
          { title: g.archive.title, desc: g.archive.desc, href: g.archive.href, variant: 'plain' },
        ],
      }
    : g,
);

const isExternal = (href) => typeof href === 'string' && href.startsWith('http');

/**
 * Icon artwork, keyed by links.json `socials[].icon`.
 *
 * ALL ARE THE OFFICIAL MARKS, per CLAUDE.md. The mockup's line drawings
 * (Instagram, TikTok, Pinterest, Substack) were approximations and were
 * replaced 2026-08-12. The Etsy mark was removed 2026-09-17 with the shop
 * link; nothing keys `etsy` any more.
 *
 * Geometry is the unmodified official glyph, taken from Simple Icons, which
 * tracks each brand's published brand kit. Each is a single path on a 24x24
 * viewBox.
 *
 * Rendered MONOCHROME via fill="currentColor", not in brand colours. Two
 * reasons, and both matter:
 *   - the palette is locked to black + white + one teal (DECISIONS.md), and
 *     an Instagram gradient or TikTok's cyan/red would break it outright;
 *   - .ico inverts to a white glyph on an ink fill on hover, which only
 *     works if the mark inherits colour.
 * Every one of these brands permits a solid one-colour version of the mark
 * for exactly this case. The glyphs are unmodified, which is the part their
 * guidelines actually police.
 *
 * substack and whatsapp are no longer in links.json (trimmed 2026-09-26)
 * but their artwork stays here, so restoring either is one JSON entry.
 *
 * The marks remain the trademarks of their owners; they are used here only
 * to link to Shauna's own profiles.
 */
const ICONS: Record<string, string> = {
