{
  "$description": "shauna.dev design tokens. Single source of truth: scripts/tokens.mjs generates src/styles/tokens.css from this file before every build. DESIGN.md explains the rules.",
  "color": {
    "paper": "#FBF8F3",
    "sand": "#F3EDE4",
    "card": "#FFFDF9",
    "ink": "#0B1416",
    "muted": "#55656A",
    "teal-text": "#1F6A75",
    "reef": "#2C8C99",
    "koa": "#A65F35",
    "white": "#FFFFFF",
    "reef-tint": "#E6F2F3",
    "reef-line": "#9CCBD1",
    "koa-tint": "#F5E8DF",
    "plate-hover": "#EEE6DA",
    "chrome-bar": "#F6F8F8",
    "chrome-dot": "#D3D9DB",
    "term-text": "#E6EEF0",
    "term-dim": "#8FA3A8",
    "term-ok": "#7FD3DC"
  },
  "art": {
    "sky": "#83BDDF",
    "lagoon": "#24C0CB",
    "art-sand": "#EDE6DD",
    "palm": "#5E6B3A",
    "haze": "#EBF6FA"
  },
  "font": {
    "display": "'Funnel Display', system-ui, sans-serif",
    "body": "'Archivo', system-ui, -apple-system, sans-serif",
    "label": "'Space Grotesk', system-ui, sans-serif"
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "radius": { "sm": 8, "md": 12, "card": 16, "pill": 999 },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "fast": "120ms",
    "base": "180ms",
    "slow": "320ms"
  },
  "contrast": {
    "$description": "Every text colour on every surface it is used on. check:ui fails the build below 4.5:1. Reef is not here on purpose: it is 3.7:1, graphics and large text only.",
    "pairs": [
      ["ink", "paper"], ["muted", "paper"], ["teal-text", "paper"], ["koa", "paper"],
      ["ink", "sand"], ["muted", "sand"], ["teal-text", "sand"],
      ["ink", "card"], ["muted", "card"], ["teal-text", "card"],
      ["white", "ink"], ["term-text", "ink"], ["term-dim", "ink"], ["term-ok", "ink"],
      ["teal-text", "reef-tint"]
    ]
  }
}
